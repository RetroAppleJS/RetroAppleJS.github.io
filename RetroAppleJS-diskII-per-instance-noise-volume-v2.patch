+    // Disk-noise volume is local to this AppleDisk2 instance. 100% keeps the
+    // historical Disk II gain (0.1); 75% is the per-instance default.
+    this.dN_volume_levels = [0,25,75,100];
+    this.dNd = {enable:false,volumePct:75,motor:"OFF",status:"",detune:0,rept:0,motorOffTimer:null,last:{}};  // disk Noise data
     this.AUD_buffer={};
 
+    this.dN_volume_get = function()
+    {
+        return this.dNd.volumePct;
+    }
+
+    this.dN_volume_icon = function()
+    {
+        switch(this.dNd.volumePct)
+        {
+            case 0:   return "fa-volume-mute";
+            case 25:  return "fa-volume-off";
+            case 75:  return "fa-volume-down";
+            default:  return "fa-volume-up";
+        }
+    }
+
+    this.dN_volume_gain = function()
+    {
+        // Preserve the old 0.1 gain as the 100% reference level.
+        return 0.1 * this.dNd.volumePct / 100;
+    }
+
+    this.dN_volume_apply = function()
+    {
+        if(this.gain && this.gain.gain)
+            this.gain.gain.value = this.dN_volume_gain();
+
+        return this.dNd.volumePct;
+    }
+
+    this.dN_volume_sync_button = function(button)
+    {
+        if(!button) return;
+
+        var pct = this.dNd.volumePct;
+        var icon = button.getElementsByTagName("i")[0];
+        if(icon) icon.className = "fa " + this.dN_volume_icon();
+
+        var label = "Disk noise volume: " + pct + "%";
+        button.title = label;
+        button.setAttribute("aria-label",label);
+        button.setAttribute("data-volume",pct);
+    }
+
+    this.dN_volume_cycle = function(button)
+    {
+        var levels = this.dN_volume_levels;
+        var idx = levels.indexOf(this.dNd.volumePct);
+
+        this.dNd.volumePct = levels[(idx < 0 ? 0 : idx + 1) % levels.length];
+        this.dN_volume_apply();
+        this.dN_volume_sync_button(button);
+
+        return this.dNd.volumePct;
+    }
