+        BNE     CHAT_OVERLAY_BAD
+        LDA     CHAT_OVL_MAGIC_ADDR+$01
+        CMP     #$31                    ; 1
+        BNE     CHAT_OVERLAY_BAD
+        LDA     CHAT_OVL_MAGIC_ADDR+$02
+        CMP     #$36                    ; 6
+        BNE     CHAT_OVERLAY_BAD
+        LDA     CHAT_OVL_MAGIC_ADDR+$03
+        CMP     #$43                    ; C
+        BNE     CHAT_OVERLAY_BAD
+        LDA     CHAT_OVL_MAGIC_ADDR+$04
+        CMP     #$01
+        BNE     CHAT_OVERLAY_BAD
+        LDA     CHAT_OVL_MAGIC_ADDR+$05
+        CMP     #$01
+        BNE     CHAT_OVERLAY_BAD
+        CLC
+        RTS
+CHAT_OVERLAY_BAD
