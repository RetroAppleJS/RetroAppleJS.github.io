+        JSR     FM_READ_AUX
+        BCC     CHAT_DISK_FAIL_CLOSE
+        CMP     #<CHAT_IMAGE_START
+        BNE     CHAT_DISK_FAIL_CLOSE
+
+        JSR     FM_READ_AUX
+        BCC     CHAT_DISK_FAIL_CLOSE
+        CMP     #>CHAT_IMAGE_START
+        BNE     CHAT_DISK_FAIL_CLOSE
+
+        ; Binary header: exact image length $1D1A.
+        JSR     FM_READ_AUX
+        BCC     CHAT_DISK_FAIL_CLOSE
+        CMP     #<CHAT_IMAGE_LEN
+        BNE     CHAT_DISK_FAIL_CLOSE
+
+        JSR     FM_READ_AUX
+        BCC     CHAT_DISK_FAIL_CLOSE
+        CMP     #>CHAT_IMAGE_LEN
+        BNE     CHAT_DISK_FAIL_CLOSE
+
+        LDA     #<CHAT_IMAGE_START
+        STA     RAM_ZP_MAIN_LO
+        LDA     #>CHAT_IMAGE_START
+        STA     RAM_ZP_MAIN_HI
+        LDA     #<CHAT_IMAGE_LEN
+        STA     RAM_ZP_LEN_LO
+        LDA     #>CHAT_IMAGE_LEN
+        STA     RAM_ZP_LEN_HI
+
+CHAT_DISK_READ_LOOP
+        LDA     RAM_ZP_LEN_LO
+        ORA     RAM_ZP_LEN_HI
+        BEQ     CHAT_DISK_READ_DONE
+
+        JSR     FM_READ_AUX
+        BCC     CHAT_DISK_FAIL_CLOSE
+
+        LDY     #$00
+        STA     (RAM_ZP_MAIN_LO),Y
+
+        INC     RAM_ZP_MAIN_LO
+        BNE     CHAT_DISK_PTR_OK
+        INC     RAM_ZP_MAIN_HI
+CHAT_DISK_PTR_OK
