10 REM MB06A2 AY0 PR4
20 N=2752:S=208694:C=0:P=0:X$=""
30 PRINT "LOADING MB-06A.2 AT $6000..."
40 FOR I=0 TO N-1 STEP 3
50 GOSUB 500:A=V
60 GOSUB 500:B=V
70 GOSUB 500:D=V
80 GOSUB 500:E=V
90 F=INT(B/16):G=INT(D/4):U=4*A+F
100 V=16*(B-16*F)+G:W=64*(D-4*G)+E
110 POKE 24576+I,U:C=C+U
120 IF (I+1<N) THEN POKE 24577+I,V:C=C+V
130 IF (I+2<N) THEN POKE 24578+I,W:C=C+W
140 NEXT I
150 IF (C<>S) THEN PRINT "CHECKSUM ERROR";C;"EXPECTED";S:END
160 PRINT "LOADED";N;"BYTES. CHECKSUM OK"
170 PRINT "E1 AY0 R0-R13 FIVE MODES"
180 HGR:CALL 24576:TEXT
190 FOR K=0 TO 4:Q=28480+24*K:GOSUB 300:NEXT K
200 PRINT "DONE. 14 AY0 REGISTERS"
210 END
300 IF (PEEK(Q)<>165) THEN PRINT "MISSING RESULT";K+1:RETURN
310 M=PEEK(Q+1):I=PEEK(Q+2)+256*PEEK(Q+17)
320 J=PEEK(Q+3)+256*PEEK(Q+16)
330 H=PEEK(Q+4)+256*PEEK(Q+5)
340 T=PEEK(Q+6)+256*PEEK(Q+7)+65536*PEEK(Q+15)
350 L=PEEK(Q+8):Z=PEEK(Q+9)
360 Y=PEEK(Q+10)+256*PEEK(Q+13):R=PEEK(Q+11)
370 PRINT "MODE";M;" IRQ";I;" E1 EVENTS";J;" ERR";R
380 PRINT "HGR WRITES";H;" EXT T2 CYCLES";T
390 IF (T>0) THEN PRINT "HGR WRITES/1000";INT(H*100000/T)/100
400 PRINT "LATE EVENTS";L;" MAX /256C";Z;" E1 BYTES";Y
410 PRINT "TIMER2 EPOCH";PEEK(Q+15);" SNAP RETRIES";PEEK(Q+12)
420 RETURN
500 IF (P>=LEN(X$)) THEN READ X$:P=0
510 V=ASC(MID$(X$,P+1,1)):P=P+1
520 IF (V=63) THEN V=ASC(MID$(X$,P+1,1))-5:P=P+1:RETURN
530 V=V-35:IF (V>27) THEN V=V-1
540 RETURN
