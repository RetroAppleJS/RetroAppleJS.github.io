10 REM MB-04 TIMER1 IRQ/HGR BENCHMARK, MOCKINGBOARD PR#4
20 N=616:S=67746:C=0
30 PRINT "LOADING MB-04 AT $6000..."
40 FOR I=0 TO N-1:READ B:POKE 24576+I,B:C=C+B:NEXT I
50 IF C<>S THEN PRINT "CHECKSUM ERROR";C;" EXPECT";S:END
60 PRINT "LOADED";N;"BYTES. CHECKSUM OK"
70 PRINT "RUNNING THREE IRQ TESTS (64 IRQ EACH)..."
80 HGR:CALL 24576:TEXT
90 FOR K=0 TO 2:Q=28432+16*K:GOSUB 300:NEXT K
100 PRINT "DONE. IRQ ENTRY SAMPLES $6E00, EXIT $6C00"
110 END
300 IF PEEK(Q)<>164 THEN PRINT "MISSING TEST";K+1:RETURN
310 M=PEEK(Q+1):I=PEEK(Q+2):W=PEEK(Q+3)+256*PEEK(Q+4)
320 T=PEEK(Q+5)+256*PEEK(Q+6):E=PEEK(Q+9)
330 PRINT "MODE";M;" IRQ";I;" HGR WRITES";W
340 PRINT "T2 CYCLES";T;" ERR";E
350 IF T>0 THEN PRINT "HGR WRITES/1000 CYCLES";INT(W*100000/T)/100
360 R=28160+64*K:Z=27648+64*K:LA=255:LB=0:SA=0:SE=0
370 FOR J=0 TO 63:A=PEEK(R+J):B=PEEK(Z+J)
380 D=A-B:IF D<0 THEN D=D+256
390 F=254-A:IF F<0 THEN F=F+256
400 IF (F<LA) THEN LA=F
410 IF (F>LB) THEN LB=F
420 SA=SA+D:SE=SE+F:NEXT J
430 PRINT "IRQ SERVICE INTERIOR AVG";SA/64;" CYCLES"
440 PRINT "IRQ ENTRY PHASE RANGE";LA;"TO";LB;" CYCLES"
450 RETURN
