10 REM MB-05 E1 TIMER1 IRQ HGR TEST PR#4
20 N=1327:S=124100:C=0:P=0:X$=""
30 PRINT "LOADING MB-05 AT $6000..."
40 FOR I=0 TO N-1
50 IF (P>=LEN(X$)) THEN READ X$:P=0
60 H=ASC(MID$(X$,P+1,1)):IF (H>57) THEN H=H-55
70 IF (H>=48) THEN H=H-48
80 L=ASC(MID$(X$,P+2,1)):IF (L>57) THEN L=L-55
90 IF (L>=48) THEN L=L-48
100 B=16*H+L:POKE 24576+I,B:C=C+B:P=P+2
110 NEXT I
120 IF C<>S THEN PRINT "CHECKSUM ERROR";C;"EXPECTED";S:END
130 PRINT "LOADED";N;"BYTES. CHECKSUM OK"
140 PRINT "E1 SCORE, THREE IRQ MODES..."
150 HGR:CALL 24576:TEXT
160 FOR K=0 TO 2:Q=28480+16*K:GOSUB 300:NEXT K
170 PRINT "DONE. T2 SAMPLES $6800/$6A00, DECODE $7000"
180 END
300 IF PEEK(Q)<>165 THEN PRINT "MISSING RESULT MODE";K+1:RETURN
310 M=PEEK(Q+1):I=PEEK(Q+2):E=PEEK(Q+3)
320 W=PEEK(Q+4)+256*PEEK(Q+5)
330 T=PEEK(Q+6)+256*PEEK(Q+7):L=PEEK(Q+8)
340 P=PEEK(Q+9):U=PEEK(Q+10):R=PEEK(Q+11)
350 PRINT "MODE";M;" IRQ";I;" E1 EVENTS";E;" ERR";R
360 PRINT "HGR WRITES";W;" T2 CYCLES";T
370 IF (T>0) THEN PRINT "HGR WRITES/1000";INT(W*100000/T)/100
380 PRINT "LATE EVENTS";L;" MAX /256C";P;" E1 BYTES";U
390 IF (I=0) THEN RETURN
400 A1=26624+128*K:A2=27136+128*K
410 A3=27648+128*K:A4=28032+128*K
420 LO=9999:HI=0:SUM=0
430 FOR J=0 TO I-1:D=PEEK(A1+J)+256*PEEK(A3+J)
440 D=D-PEEK(A2+J)-256*PEEK(A4+J)
450 IF (D<0) THEN D=D+65536
460 IF (D<LO) THEN LO=D
470 IF (D>HI) THEN HI=D
480 SUM=SUM+D:NEXT J
490 PRINT "IRQ INTERIOR AVG";SUM/I;" RANGE";LO;"TO";HI
500 V1=28672+64*K:SU=0:LO=255:HI=0
510 FOR J=0 TO 62:D=PEEK(V1+J):SU=SU+D
520 IF (D<LO) THEN LO=D
530 IF (D>HI) THEN HI=D
540 NEXT J
550 PRINT "DECODER SPAN AVG";SU/63;" RANGE";LO;"TO";HI
560 RETURN
