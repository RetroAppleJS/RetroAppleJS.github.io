+test("include rows retain listing syntax compatibility without emitting bytes",()=>{
+    const result=assemble('*=$2000\n!source "code.a"',{includes:{"code.a":"rts"},listingColumns:{adr:0,code:6,ins:20,opr:30,asm:50,com:60}});
